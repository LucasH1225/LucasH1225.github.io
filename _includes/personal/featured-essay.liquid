<article class="featured-essay">
  <div class="essay-date">{{ site.data.personal.essay.year }}</div>
  <div>
    <h3><a href="{{ site.data.personal.essay.url | relative_url }}">{{ site.data.personal.essay.title }}</a></h3>
    <p>{{ site.data.personal.essay.summary }}</p>
    <p class="essay-note">{{ site.data.personal.essay.context }}<br>{{ site.data.personal.essay.status }}</p>
  </div>
</article>
