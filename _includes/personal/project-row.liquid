{% assign project = include.project %}
<article class="project-row">
  <a class="project-image {{ project.thumbnail_class }}" href="{{ project.url | relative_url }}" aria-label="Read about {{ project.title | escape }}">
    <img src="{{ project.thumbnail | default: project.image | relative_url }}" alt="{{ project.thumbnail_alt | default: project.image_alt | escape }}" width="{{ project.image_width }}" height="{{ project.image_height }}" loading="lazy">
  </a>
  <div class="project-copy">
    <div class="project-heading"><h3><a href="{{ project.url | relative_url }}">{{ project.title }}</a></h3>{% if project.featured_order == 1 %}<span class="status"><span class="status-dot" aria-hidden="true"></span>{{ project.status }}</span>{% endif %}</div>
    <p>{{ project.summary }}</p>
    <div class="project-bottom"><span class="technology">{{ project.stack }}</span>{% if project.featured_order == 1 %}<a class="text-link" href="{{ project.url | relative_url }}">Read the project</a>{% else %}<a class="status" href="{{ project.url | relative_url }}">{{ project.status }}</a>{% endif %}</div>
  </div>
</article>
