---
layout: personal
---
<article class="writing-article">
  <a class="back-link" href="{{ '/blog/' | relative_url }}"><span aria-hidden="true">←</span> All writing</a>
  <header class="article-header">
    <h1>{{ page.title }}</h1>
    <p class="article-meta"><time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%-d %B %Y' }}</time>{% if page.topic %}<span>{{ page.topic }}</span>{% endif %}</p>
    {% if page.featured_essay %}<p class="article-context">{{ site.data.personal.essay.context }}<br>{{ site.data.personal.essay.status }}</p>{% endif %}
  </header>
  <div class="article-prose">{{ content }}</div>
  <div class="article-end"><a href="{{ '/blog/' | relative_url }}">Back to writing</a></div>
</article>
